<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kelo_hub_wheel">

    <xacro:macro name="kelo_hub_wheel"
        params="wheel_prefix parent *wheel_origin wheel_mesh tyre_mesh mesh_rpy
    use_ros2_control use_gz_sim use_kelo_tulip">

        <xacro:property name="mesh_package" value="eddie_description" />

        <!-- wheel joint type based on use_kelo_tulip -->
        <xacro:if value="${use_kelo_tulip}">
            <xacro:property name="wheel_joint_type" value="continuous" />
        </xacro:if>
        <xacro:unless value="${use_kelo_tulip}">
            <xacro:property name="wheel_joint_type" value="fixed" />
        </xacro:unless>

        <!-- Links -->
        <link name="${wheel_prefix}link">
            <visual>
                <origin rpy="${mesh_rpy}" xyz="0 0 0" />
                <geometry>
                    <mesh filename="package://${mesh_package}/meshes/${wheel_mesh}" scale="0.001 0.001 0.001" />
                </geometry>
                <material name="wheel_light" />
            </visual>
            <visual>
                <origin rpy="${mesh_rpy}" xyz="0 0 0" />
                <geometry>
                    <mesh filename="package://${mesh_package}/meshes/${tyre_mesh}" scale="0.001 0.001 0.001" />
                </geometry>
                <material name="tyre_dark" />
            </visual>

            <!-- only the tread ring touches the ground -->
            <collision>
                <origin rpy="${mesh_rpy}" xyz="0 0 0" />
                <geometry>
                    <mesh filename="package://${mesh_package}/meshes/${tyre_mesh}" scale="0.001 0.001 0.001" />
                </geometry>
            </collision>

            <surface>
                <friction>
                    <ode>
                        <mu>0.2</mu>
                        <mu2>0.1</mu2>
                    </ode>
                </friction>
            </surface>

            <!-- spin axis is x, so the polar moment is ixx -->
            <inertial>
                <mass value="1.563" />
                <origin rpy="0 0 0" xyz="0 0 0" />
                <inertia ixx="0.001579986" ixy="0" ixz="0" iyy="0.001012837" iyz="0"
                    izz="0.001013130" />
            </inertial>
        </link>

        <!-- Joints -->
        <joint name="${wheel_prefix}joint" type="${wheel_joint_type}">
            <parent link="${parent}" />
            <child link="${wheel_prefix}link" />
            <xacro:insert_block name="wheel_origin" />
            <axis xyz="-1 0 0" />
            <dynamics damping="0.1" friction="0.1" />
        </joint>

        <xacro:if value="${use_kelo_tulip}">
            <!-- ros2 control tags -->
            <xacro:if value="${use_ros2_control}">
                <ros2_control name="${wheel_prefix}ctr" type="system">
                    <xacro:if value="${use_gz_sim}">
                        <hardware>
                            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                        </hardware>
                    </xacro:if>
                    <joint name="${wheel_prefix}joint">
                        <command_interface name="position">
                            <param name="min">-1e+100</param>
                            <param name="max">1e+100</param>
                        </command_interface>
                        <command_interface name="velocity">
                            <param name="min">-1e+100</param>
                            <param name="max">1e+100</param>
                        </command_interface>
                        <command_interface name="effort">
                            <param name="min">-1e+100</param>
                            <param name="max">1e+100</param>
                        </command_interface>
                        <state_interface name="position">
                            <param name="initial_value">0.0</param>
                        </state_interface>
                        <state_interface name="velocity" />
                        <state_interface name="effort" />
                    </joint>
                </ros2_control>
            </xacro:if>
        </xacro:if>

    </xacro:macro>

</robot>
